# AyurChain Backend Environment Variables Template
# Copy this to .env and fill in your actual values

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ayurchain?retryWrites=true&w=majority

# CORS — allowed frontend origins
CORS_ORIGIN=https://ayur-chain-three.vercel.app

# IPFS / Pinata
# PINATA_API_KEY=
# PINATA_SECRET_KEY=
